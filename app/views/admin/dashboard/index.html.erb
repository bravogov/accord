<% content_for :page_title, "Dashboard" %>
<% content_for :title, "Dashboard" %>

<div class="govuk-grid-row govuk-!-margin-bottom-8">
  <div class="govuk-grid-column-one-third">
    <%= render "govuk_publishing_components/components/heading", {
      text: "Writing and publishing",
      font_size: "m",
      heading_level: 2,
      margin_bottom: 4,
    } %>

    <%= render "govuk_publishing_components/components/list", {
      visible_counters: true,
      items: [
        link_to("New document", admin_new_document_path, class: "govuk-link"),
        link_to("Documents", admin_editions_path, class: "govuk-link"),
      ],
    } %>
  </div>

  <div class="govuk-grid-column-one-third">
    <%= render "govuk_publishing_components/components/heading", {
      text: "Organisation publishing",
      font_size: "m",
      heading_level: 2,
      margin_bottom: 4,
    } %>

    <%= render "govuk_publishing_components/components/list", {
      visible_counters: true,
      items: [
        *(current_user.organisation ? [
          link_to("Manage organisation", admin_organisation_path(current_user.organisation), class: "govuk-link"),
          link_to("Corporate information", admin_organisation_corporate_information_pages_path(current_user.organisation), class: "govuk-link"),
        ] : []),
      ],
    } %>
  </div>

  <div class="govuk-grid-column-one-third">
    <%= render "govuk_publishing_components/components/heading", {
      text: "Publishing tools",
      font_size: "m",
      heading_level: 2,
      margin_bottom: 4,
    } %>

    <%= render "govuk_publishing_components/components/list", {
      visible_counters: true,
      items: [
        link_to("Accord bookmarklets", admin_bookmarklets_instructions_index_path, class: "govuk-link"),
      ],
    } %>
  </div>
</div>

<%= render "govuk_publishing_components/components/heading", {
  text: "My draft documents",
  font_size: "l",
  heading_level: 2,
  margin_bottom: 4,
} %>

<%= render "document_table", documents: @draft_documents, title: "draft documents" %>

<% if current_user.organisation %>
  <%= render "govuk_publishing_components/components/heading", {
    text: "#{organisation_acronym_or_name(current_user.organisation)}’s force-published documents",
    font_size: "l",
    heading_level: 2,
    margin_bottom: 4,
  } %>
  <p class="govuk-body"><%= link_to "View complete list of forced-published documents", admin_editions_path(state: :force_published, organisation: current_user.organisation), class: "govuk-link" %></p>

  <%= render "document_table", documents: @force_published_documents, title: "force published documents" %>
<% end %>
