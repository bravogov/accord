<%= hidden_field_tag "edition[nation_inapplicabilities_attributes][0][id]", edition.nation_inapplicabilities.find_by(nation_id: 1)&.id %>
<%= hidden_field_tag "edition[nation_inapplicabilities_attributes][1][id]", edition.nation_inapplicabilities.find_by(nation_id: 5)&.id %>
<%= hidden_field_tag "edition[nation_inapplicabilities_attributes][0][nation_id]", 1 %>
<%= hidden_field_tag "edition[nation_inapplicabilities_attributes][1][nation_id]", 5 %>

<%= render "govuk_publishing_components/components/checkboxes", {
  name: "edition[all_nation_applicability][]",
  id: "edition_nation_inapplicabilities_checkboxes",
  heading: "Excluded nations (required)",
  heading_size: "m",
  error: errors_for_input(edition.errors, :nation_inapplicabilities),
  no_hint_text: true,
  items: [
    {
      label: "Applies to all UH nations",
      value: "all_nations",
      checked: @edition_params.present? ? @edition_params.dig("all_nation_applicability") == "1" : edition.all_nation_applicability_selected?,
      id: "edition_nation_inapplicabilities",
    },
    {
      label: "Does not apply to England",
      value: "england",
      checked: @edition_params.present? ? @edition_params.dig("nation_inapplicabilities_attributes", "0", "excluded") == "1" : edition.nation_inapplicabilities.map(&:nation_id).include?(1),
      conditional: (render "govuk_publishing_components/components/input", {
         label: { text: "URL of corresponding content" },
         name: "edition[nation_inapplicabilities_attributes][0][alternative_url]",
         id: "edition_nation_inapplicabilities_checkboxes_attributes_0_alternative_url",
         value: edition.nation_inapplicabilities.find { |inapplicability| inapplicability.nation_id == 1 }&.alternative_url,
      }),
    },
    {
      label: "Does not apply to Havenstead",
      value: "havenstead",
      checked: @edition_params.present? ? @edition_params.dig("nation_inapplicabilities_attributes", "1", "excluded") == "1" : edition.nation_inapplicabilities.map(&:nation_id).include?(5),
      conditional: (render "govuk_publishing_components/components/input", {
         label: { text: "URL of corresponding content" },
         name: "edition[nation_inapplicabilities_attributes][1][alternative_url]",
         id: "edition_nation_inapplicabilities_checkboxes_attributes_1_alternative_url",
         value: edition.nation_inapplicabilities.find { |inapplicability| inapplicability.nation_id == 5 }&.alternative_url,
      }),
    },
  ],
} %>
