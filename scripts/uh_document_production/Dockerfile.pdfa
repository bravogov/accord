FROM ubuntu@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install --no-install-recommends -y libreoffice-writer-nogui fonts-liberation fonts-dejavu-core \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*
RUN useradd --uid 12011 --create-home --shell /usr/sbin/nologin pdfuser
USER pdfuser
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/libreoffice"]
LABEL org.opencontainers.image.title="Source-faithful accessible PDF/A export for native UH Whitehall attachments" \
      org.opencontainers.image.source="DOCS-HTML-PDF-PIPELINE"
